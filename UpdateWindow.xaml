<Window x:Class="FastCraft.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FastCraft update" Height="500" Width="660" MinHeight="380" MinWidth="540"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Brush.Bg}" Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="22" To="0" Duration="0:0:0.45">
                        <DoubleAnimation.EasingFunction>
                            <QuinticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3"/>
                    <DoubleAnimation Storyboard.TargetName="TopGlow" Storyboard.TargetProperty="Opacity"
                                     From="0.5" To="1" Duration="0:0:2.2"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="Root">
        <Grid.RenderTransform>
            <TranslateTransform X="0" Y="0"/>
        </Grid.RenderTransform>

        <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"/>

        <!-- light spilling from behind the card -->
        <Ellipse x:Name="TopGlow" Width="640" Height="340" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-190,-60,0" IsHitTestVisible="False" Opacity="0.8">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#40FFB35C" Offset="0"/>
                    <GradientStop Color="#00FFB35C" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- the whole header drags the window; no caption buttons on a dialog -->
            <Grid Grid.Row="0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#111824" Offset="0"/>
                        <GradientStop Color="#0A0D13" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Grid Width="22" Height="22">
                        <Ellipse Fill="#FFC077" Opacity="0.35">
                            <Ellipse.Effect>
                                <BlurEffect Radius="10"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Image Source="{StaticResource BrandMark}" Width="18" Height="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <TextBlock Text="FastCraft update" Margin="9,0,0,0" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00D9A55B" Offset="0"/>
                        <GradientStop Color="#88FFC077" Offset="0.42"/>
                        <GradientStop Color="#00D9A55B" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Grid.Row="1" Margin="26,22,26,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="A NEW BUILD IS READY" Style="{StaticResource Text.Label}"/>
                <TextBlock x:Name="VersionText" Grid.Row="1" Margin="0,9,0,0" FontSize="18" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="{StaticResource Brush.HeroText}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF9E44" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/>
                    </TextBlock.Effect>
                </TextBlock>

                <Border Grid.Row="2" CornerRadius="12" Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" Padding="18,15"
                        Margin="0,18,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="NotesText" TextWrapping="Wrap" LineHeight="21"
                                   LineStackingStrategy="BlockLineHeight"
                                   Foreground="{StaticResource Brush.TextDim}"/>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="3" Margin="0,18,0,0">
                    <ProgressBar x:Name="Progress" Style="{StaticResource Progress.Slim}" Height="4"
                                 Minimum="0" Maximum="1" Value="0" Visibility="Collapsed"/>
                    <TextBlock x:Name="StatusText" Margin="0,9,0,0" Style="{StaticResource Text.Body}"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="UpdateButton" Style="{StaticResource Button.Primary}" Content="Update now"
                            Click="UpdateButton_Click"/>
                    <Button x:Name="LaterButton" Style="{StaticResource Button.Ghost}" Content="Later"
                            Margin="12,0,0,0" Padding="20,15" Click="LaterButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
