<Window x:Class="FastCraft.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FastCraft update" Height="470" Width="640" MinHeight="360" MinWidth="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Brush.Bg}" Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- the whole header drags the window; no caption buttons on a dialog -->
            <Grid Grid.Row="0" Background="{StaticResource Brush.Sidebar}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="{StaticResource BrandMark}" Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="FastCraft update" Margin="9,0,0,0" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="A NEW BUILD IS READY" Style="{StaticResource Text.Label}"/>
                <TextBlock x:Name="VersionText" Grid.Row="1" Margin="0,8,0,0" FontSize="17" FontWeight="SemiBold"
                           TextWrapping="Wrap"/>

                <Border Grid.Row="2" Background="{StaticResource Brush.Surface}" CornerRadius="10"
                        BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" Padding="14,12"
                        Margin="0,16,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="NotesBox" Background="Transparent" BorderThickness="0"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 Foreground="{StaticResource Brush.TextDim}"
                                 SelectionBrush="{StaticResource Brush.Accent}"/>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <ProgressBar x:Name="Progress" Style="{StaticResource Progress.Slim}" Height="4"
                                 Minimum="0" Maximum="1" Value="0" Visibility="Collapsed"/>
                    <TextBlock x:Name="StatusText" Margin="0,8,0,0" Style="{StaticResource Text.Body}"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="UpdateButton" Style="{StaticResource Button.Primary}" Content="Update now"
                            Click="UpdateButton_Click"/>
                    <Button x:Name="LaterButton" Style="{StaticResource Button.Ghost}" Content="Later"
                            Margin="10,0,0,0" Click="LaterButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
