<Window x:Class="FastCraft.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastCraft update" Height="420" Width="620" MinHeight="320" MinWidth="500"
        WindowStartupLocation="CenterOwner" Background="#F4F5F7"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="A new FastCraft is available" FontSize="18" FontWeight="Bold"
                   Foreground="#111827"/>
        <TextBlock x:Name="VersionText" Grid.Row="1" Margin="0,6,0,0" Foreground="#374151"
                   TextWrapping="Wrap"/>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="8" Padding="10" Margin="0,12,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="NotesBox" Background="Transparent" BorderThickness="0"
                         IsReadOnly="True" TextWrapping="Wrap" Foreground="#374151"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="1" Value="0"
                         Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" Foreground="#4B5563" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="UpdateButton" Content="Update now" Padding="18,8" FontWeight="SemiBold"
                    Background="#2563EB" Foreground="White" BorderThickness="0"
                    Click="UpdateButton_Click"/>
            <Button x:Name="LaterButton" Content="Later" Padding="18,8" Margin="10,0,0,0"
                    Click="LaterButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
