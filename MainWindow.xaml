<Window x:Class="FastCraft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastCraft" Height="740" Width="960" MinHeight="620" MinWidth="840"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / account -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="FastCraft" FontSize="26" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="fast launcher for Minecraft: Java Edition" Margin="14,0,0,0"
                           Foreground="#6B7280" VerticalAlignment="Bottom"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="AccountText" Text="Not signed in" Foreground="#374151"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="SignInButton" Content="Sign in with Microsoft" Padding="12,6"
                        Click="SignInButton_Click"/>
                <Button x:Name="SignOutButton" Content="Sign out" Padding="12,6" Margin="8,0,0,0"
                        Click="SignOutButton_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <!-- Version picker -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,16,0,0"
                BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Version" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="#374151"/>
                <ComboBox x:Name="VersionCombo" Grid.Column="1" Height="30" VerticalContentAlignment="Center"/>
                <Button x:Name="RefreshVersionsButton" Grid.Column="2" Content="Refresh list"
                        Padding="12,6" Margin="10,0,0,0" Click="RefreshVersionsButton_Click"/>
                <CheckBox x:Name="SnapshotsCheck" Grid.Column="3" Content="Show snapshots"
                          Margin="14,0,0,0" VerticalAlignment="Center"
                          Checked="SnapshotsCheck_Changed" Unchecked="SnapshotsCheck_Changed"/>
                <TextBlock x:Name="DeviceCodeText" Grid.Column="4" Foreground="#B45309"
                           VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Launch buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="LaunchButton" Content="Launch Minecraft" Padding="22,10" FontSize="15"
                    FontWeight="SemiBold" Background="#2563EB" Foreground="White" BorderThickness="0"
                    Click="LaunchButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Padding="16,10" Margin="10,0,0,0"
                    IsEnabled="False" Click="CancelButton_Click"/>
            <Button x:Name="FolderButton" Content="Open game folder" Padding="16,10" Margin="10,0,0,0"
                    Click="FolderButton_Click"/>
            <CheckBox x:Name="OfflineCheck" Content="Offline mode" Margin="16,0,0,0" VerticalAlignment="Center"
                      Checked="OfflineCheck_Changed" Unchecked="OfflineCheck_Changed"/>
            <TextBox x:Name="OfflineNameBox" Width="120" Height="28" Margin="8,0,0,0"
                     VerticalContentAlignment="Center" IsEnabled="False"
                     TextChanged="OfflineNameBox_TextChanged"
                     ToolTip="Player name for offline play: 3-16 letters, digits or _"/>
            <TextBlock x:Name="OfflineHint" Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="210"
                       TextWrapping="Wrap" Foreground="#B45309" Visibility="Collapsed"
                       Text="Single player and LAN only — online servers and Realms need a sign-in."/>
        </StackPanel>

        <!-- Progress -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="1" Value="0"/>
            <TextBlock x:Name="StatusText" Text="Idle" Margin="0,6,0,0" Foreground="#4B5563"/>
        </StackPanel>

        <!-- Log -->
        <Border Grid.Row="4" Background="#111827" CornerRadius="8" Padding="10" Margin="0,14,0,0">
            <TextBox x:Name="LogBox" Background="Transparent" Foreground="#D1D5DB"
                     BorderThickness="0" FontFamily="Consolas" FontSize="12"
                     IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Settings -->
        <Expander Grid.Row="5" Header="Settings" Margin="0,14,0,0" IsExpanded="False">
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="8" Padding="14" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Memory"
                               VerticalAlignment="Center" Foreground="#374151"/>
                    <Slider x:Name="MemorySlider" Grid.Row="0" Grid.Column="1"
                            Minimum="1024" Maximum="32768" TickFrequency="512" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" Margin="0,4" ValueChanged="MemorySlider_ValueChanged"/>
                    <TextBlock x:Name="MemoryText" Grid.Row="0" Grid.Column="2" Text="4096 MB"
                               VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#374151"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Java path (optional)"
                               VerticalAlignment="Center" Foreground="#374151" Margin="0,6,0,0"/>
                    <TextBox x:Name="JavaPathBox" Grid.Row="1" Grid.Column="1" Height="28"
                             VerticalContentAlignment="Center" Margin="0,6,0,0"
                             TextChanged="JavaPathBox_TextChanged"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Padding="12,4" Margin="10,6,0,0"
                            Click="BrowseJavaButton_Click"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Extra JVM args"
                               VerticalAlignment="Center" Foreground="#374151" Margin="0,6,0,0"/>
                    <TextBox x:Name="ExtraJvmBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                             Height="28" VerticalContentAlignment="Center" Margin="0,6,0,0"
                             TextChanged="ExtraJvmBox_TextChanged"/>

                    <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
                        <CheckBox x:Name="DownloadJavaCheck" Content="Download Java from Mojang when missing"
                                  Margin="0,0,18,0" Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                        <CheckBox x:Name="TurboCheck" Content="Turbo JVM flags (Java 17+)"
                                  Margin="0,0,18,0" Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                        <CheckBox x:Name="KeepOpenCheck" Content="Keep launcher open while playing"
                                  Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                        <CheckBox x:Name="CheckUpdatesCheck" Content="Check for updates on startup"
                                  Margin="18,0,0,0" Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                        <Button x:Name="CheckUpdatesButton" Content="Check now" Padding="12,2" Margin="10,0,0,0"
                                VerticalAlignment="Center" Click="CheckUpdatesButton_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Expander>
    </Grid>
</Window>
