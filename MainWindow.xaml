<Window x:Class="FastCraft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FastCraft" Height="740" Width="1020" MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Brush.Bg}" Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Ambient light. Three soft orbs drift behind the pages at different speeds
         and never in sync, which is what stops the background from reading as a
         flat fill. They animate forever on the GPU clock, not on the dispatcher. -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BrandGlow" Storyboard.TargetProperty="Opacity"
                                     From="0.22" To="0.62" Duration="0:0:2.8"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="AuroraA"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="-40" To="80" Duration="0:0:17"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="AuroraA"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="-20" To="60" Duration="0:0:23"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="AuroraB"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="30" To="-70" Duration="0:0:21"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="AuroraB"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="10" To="-50" Duration="0:0:14"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="AuroraC"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="-60" To="50" Duration="0:0:27"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="AuroraC" Storyboard.TargetProperty="Opacity"
                                     From="0.35" To="0.85" Duration="0:0:9"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- title bar -->
        <Grid Grid.Row="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#111824" Offset="0"/>
                    <GradientStop Color="#0A0D13" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Grid Width="24" Height="24">
                    <Ellipse x:Name="BrandGlow" Fill="#FFC077" Opacity="0.3">
                        <Ellipse.Effect>
                            <BlurEffect Radius="11"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <Image Source="{StaticResource BrandMark}" Width="20" Height="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <TextBlock Text="FastCraft" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Border Background="#1FD9A55B" BorderBrush="#3DD9A55B" BorderThickness="1"
                        CornerRadius="5" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleVersion" Text="1.0.0" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Accent}"/>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Window}" Click="Minimize_Click" ToolTip="Minimise"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M 0,0 L 10,0" Stroke="{StaticResource Brush.TextDim}" StrokeThickness="1.2"/>
                </Button>
                <Button Style="{StaticResource Button.Window}" Click="Maximize_Click" ToolTip="Maximise"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z" Stroke="{StaticResource Brush.TextDim}"
                          StrokeThickness="1.2"/>
                </Button>
                <Button Style="{StaticResource Button.WindowClose}" Click="Close_Click" ToolTip="Close"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M 0,0 L 9.5,9.5 M 9.5,0 L 0,9.5" Stroke="{StaticResource Brush.TextDim}"
                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- the accent hairline under the title bar: bright in the middle, gone at both ends -->
        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00D9A55B" Offset="0"/>
                    <GradientStop Color="#88FFC077" Offset="0.42"/>
                    <GradientStop Color="#00D9A55B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- sidebar -->
            <Border Grid.Column="0" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0C1119" Offset="0"/>
                        <GradientStop Color="#080B10" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Margin="14,20,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="NavLabel" Text="LAUNCHER" Style="{StaticResource Text.Label}"
                                   Margin="16,0,0,10"/>
                        <RadioButton x:Name="NavPlay" Style="{StaticResource Nav.Item}" Content="Play"
                                     GroupName="Nav" IsChecked="True" Tag="play" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavVersions" Style="{StaticResource Nav.Item}" Content="Versions"
                                     GroupName="Nav" Margin="0,2,0,0" Tag="versions" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource Nav.Item}" Content="Settings"
                                     GroupName="Nav" Margin="0,2,0,0" Tag="settings" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavLog" Style="{StaticResource Nav.Item}" Content="Logs"
                                     GroupName="Nav" Margin="0,2,0,0" Tag="log" Checked="Nav_Checked"/>
                    </StackPanel>

                    <!-- account card: lit from behind, the only bright thing in the rail -->
                    <Grid Grid.Row="2">
                        <Border CornerRadius="14" Background="#44FFC077" Opacity="0.25" Margin="-1">
                            <Border.Effect>
                                <BlurEffect Radius="18"/>
                            </Border.Effect>
                        </Border>
                        <Border Background="{StaticResource Brush.Surface}" CornerRadius="12"
                                BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" Padding="13">
                            <StackPanel>
                                <TextBlock Text="ACCOUNT" Style="{StaticResource Text.Label}"/>
                                <TextBlock x:Name="AccountText" Text="Not signed in" Margin="0,8,0,0"
                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DeviceCodeText" Margin="0,6,0,0" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{StaticResource Brush.Accent}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="SignInButton" Style="{StaticResource Button.Primary}" Content="Sign in"
                                            Padding="14,8" FontSize="12" Click="SignInButton_Click"/>
                                    <Button x:Name="SignOutButton" Style="{StaticResource Button.Ghost}" Content="Sign out"
                                            Padding="12,8" FontSize="12" Margin="8,0,0,0" IsEnabled="False"
                                            Click="SignOutButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- pages, with the ambient light underneath them -->
            <Grid Grid.Column="1" x:Name="PageHost" ClipToBounds="True">

                <Ellipse x:Name="AuroraA" Width="760" Height="760" HorizontalAlignment="Right"
                         VerticalAlignment="Top" Margin="0,-340,-280,0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#40FFB35C" Offset="0"/>
                            <GradientStop Color="#00FFB35C" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="0" Y="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse x:Name="AuroraB" Width="620" Height="620" HorizontalAlignment="Left"
                         VerticalAlignment="Bottom" Margin="-220,0,0,-260" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#3A7A5CFF" Offset="0"/>
                            <GradientStop Color="#007A5CFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="0" Y="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse x:Name="AuroraC" Width="520" Height="520" HorizontalAlignment="Right"
                         VerticalAlignment="Bottom" Margin="0,0,80,-280" Opacity="0.6" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#333FA9F5" Offset="0"/>
                            <GradientStop Color="#003FA9F5" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="0" Y="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- play page -->
                <Grid x:Name="PlayPage" Margin="38,32,38,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- watermark: the mark sitting in its own pool of light -->
                    <Grid Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Width="380" Height="380" Margin="0,0,-16,-28" IsHitTestVisible="False">
                        <Ellipse Width="380" Height="380">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#2EFFC077" Offset="0"/>
                                    <GradientStop Color="#00FFC077" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Image Source="{StaticResource BrandMark}" Width="210" Height="210" Opacity="0.07"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>

                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{StaticResource Brush.Accent}" Margin="0,0,9,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFC077" BlurRadius="12" ShadowDepth="0" Opacity="0.95"/>
                                </Border.Effect>
                            </Border>
                            <TextBlock Text="READY TO PLAY" Style="{StaticResource Text.Label}"/>
                        </StackPanel>

                        <TextBlock x:Name="VersionHero" Text="—" FontSize="46" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.HeroText}" Margin="0,10,0,0"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FF9E44" BlurRadius="28" ShadowDepth="0" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <TextBlock x:Name="VersionMeta" Text="No version selected"
                                   Style="{StaticResource Text.Body}" Margin="0,4,0,0"/>

                        <Border Height="1" Width="160" HorizontalAlignment="Left" Margin="0,20,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#AAFFC077" Offset="0"/>
                                    <GradientStop Color="#00FFC077" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,28,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LaunchButton" Style="{StaticResource Button.Primary}"
                                    Content="Launch Minecraft" Click="LaunchButton_Click"/>
                            <Button x:Name="CancelButton" Style="{StaticResource Button.Ghost}" Content="Cancel"
                                    Margin="12,0,0,0" Padding="20,15" IsEnabled="False" Click="CancelButton_Click"/>
                            <Button x:Name="FolderButton" Style="{StaticResource Button.Ghost}" Content="Open folder"
                                    Margin="10,0,0,0" Padding="20,15" Click="FolderButton_Click"/>
                        </StackPanel>

                        <Border Margin="0,24,0,0" HorizontalAlignment="Left" CornerRadius="12"
                                Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Line}"
                                BorderThickness="1" Padding="16,13">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="OfflineCheck" Style="{StaticResource Toggle}" Content="Offline mode"
                                          VerticalAlignment="Center" Checked="OfflineCheck_Changed"
                                          Unchecked="OfflineCheck_Changed"/>
                                <TextBox x:Name="OfflineNameBox" Style="{StaticResource Input}" Width="140" Height="32"
                                         Margin="18,0,0,0" IsEnabled="False" TextChanged="OfflineNameBox_TextChanged"
                                         ToolTip="Player name for offline play: 3-16 letters, digits or _"/>
                                <TextBlock x:Name="OfflineHint" Text="Single player and LAN only — online servers need a sign-in."
                                           Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Warn}"
                                           MaxWidth="310" Margin="18,0,0,0" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- versions page -->
                <Grid x:Name="VersionsPage" Margin="38,32,38,24" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="VERSIONS" Style="{StaticResource Text.Label}"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,16">
                        <Button x:Name="RefreshVersionsButton" Style="{StaticResource Button.Ghost}"
                                Content="Refresh list" Click="RefreshVersionsButton_Click"/>
                        <CheckBox x:Name="SnapshotsCheck" Style="{StaticResource Toggle}" Content="Show snapshots"
                                  Margin="20,0,0,0" VerticalAlignment="Center"
                                  Checked="SnapshotsCheck_Changed" Unchecked="SnapshotsCheck_Changed"/>
                    </StackPanel>

                    <Border Grid.Row="2" CornerRadius="12" Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" Padding="6">
                        <ListBox x:Name="VersionList" Style="{StaticResource List.Version}"
                                 SelectionChanged="VersionList_SelectionChanged"/>
                    </Border>
                </Grid>

                <!-- settings page -->
                <Grid x:Name="SettingsPage" Margin="38,32,38,24" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="SETTINGS" Style="{StaticResource Text.Label}"/>

                    <Border Grid.Row="1" CornerRadius="12" Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" Padding="20,18"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Memory" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextDim}"/>
                            <Slider x:Name="MemorySlider" Grid.Row="0" Grid.Column="1" Style="{StaticResource Slider.Slim}"
                                    Minimum="1024" Maximum="32768" TickFrequency="512" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" Margin="0,0,14,0"
                                    ValueChanged="MemorySlider_ValueChanged"/>
                            <TextBlock x:Name="MemoryText" Grid.Row="0" Grid.Column="2" Text="4096 MB"
                                       MinWidth="64" TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Java path" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextDim}" Margin="0,16,0,0"/>
                            <TextBox x:Name="JavaPathBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Input}"
                                     Height="32" Margin="0,16,14,0" TextChanged="JavaPathBox_TextChanged"/>
                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Button.Ghost}"
                                    Content="Browse…" Padding="12,6" Margin="0,16,0,0"
                                    Click="BrowseJavaButton_Click"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Extra JVM args" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextDim}" Margin="0,16,0,0"/>
                            <TextBox x:Name="ExtraJvmBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                     Style="{StaticResource Input}" Height="32" Margin="0,16,0,0"
                                     TextChanged="ExtraJvmBox_TextChanged"
                                     ToolTip="For example: -XX:+UseZGC -Dfile.encoding=UTF-8"/>

                            <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,20,0,0">
                                <CheckBox x:Name="DownloadJavaCheck" Style="{StaticResource Toggle}"
                                          Content="Download Java from Mojang when missing" Margin="0,0,24,8"
                                          Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                                <CheckBox x:Name="TurboCheck" Style="{StaticResource Toggle}"
                                          Content="Turbo JVM flags (Java 17+)" Margin="0,0,24,8"
                                          Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                                <CheckBox x:Name="KeepOpenCheck" Style="{StaticResource Toggle}"
                                          Content="Keep launcher open while playing" Margin="0,0,24,8"
                                          Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                            </WrapPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                                        Margin="0,12,0,0">
                                <CheckBox x:Name="CheckUpdatesCheck" Style="{StaticResource Toggle}"
                                          Content="Check for updates on startup" VerticalAlignment="Center"
                                          Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                                <Button x:Name="CheckUpdatesButton" Style="{StaticResource Button.Ghost}"
                                        Content="Check now" Padding="12,6" Margin="24,0,0,0"
                                        Click="CheckUpdatesButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- log page -->
                <Grid x:Name="LogPage" Margin="38,32,38,24" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="LOG" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
                        <TextBlock Text="everything FastCraft and Minecraft wrote" Style="{StaticResource Text.Body}"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Row="1" CornerRadius="12" Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" Padding="14,12"
                            Margin="0,14,0,0">
                        <TextBox x:Name="LogBox" Background="Transparent" Foreground="{StaticResource Brush.TextDim}"
                                 BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                 IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 SelectionBrush="{StaticResource Brush.Accent}"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- status strip -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Padding="20,11">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0C1119" Offset="0"/>
                    <GradientStop Color="#090C11" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusDot" Grid.Column="0" Width="7" Height="7" Fill="{StaticResource Brush.Accent}"
                         Opacity="0.7" VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#FFC077" BlurRadius="12" ShadowDepth="0" Opacity="1"/>
                    </Ellipse.Effect>
                </Ellipse>

                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Idle" Margin="11,0,0,0"
                           Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <ProgressBar x:Name="Progress" Grid.Column="2" Style="{StaticResource Progress.Slim}"
                             Width="240" Height="4" Minimum="0" Maximum="1" Value="0"
                             VerticalAlignment="Center" Margin="18,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
