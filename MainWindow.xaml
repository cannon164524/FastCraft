<Window x:Class="FastCraft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FastCraft" Height="720" Width="1000" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Brush.Bg}" Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================ title bar ============================ -->
        <Grid Grid.Row="0" Background="{StaticResource Brush.Sidebar}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="{StaticResource BrandMark}" Width="20" Height="20"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="FastCraft" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleVersion" Text="1.0.0" Margin="9,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource Text.Label}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Window}" Click="Minimize_Click" ToolTip="Minimise"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M 0,0 L 10,0" Stroke="{StaticResource Brush.TextDim}" StrokeThickness="1.2"/>
                </Button>
                <Button Style="{StaticResource Button.Window}" Click="Maximize_Click" ToolTip="Maximise"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z" Stroke="{StaticResource Brush.TextDim}"
                          StrokeThickness="1.2"/>
                </Button>
                <Button Style="{StaticResource Button.WindowClose}" Click="Close_Click" ToolTip="Close"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M 0,0 L 9.5,9.5 M 9.5,0 L 0,9.5" Stroke="{StaticResource Brush.TextDim}"
                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================== body ============================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- sidebar -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}"
                    BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0">
                <Grid Margin="14,18,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="NavLabel" Text="LAUNCHER" Style="{StaticResource Text.Label}"
                                   Margin="14,0,0,8"/>
                        <RadioButton x:Name="NavPlay" Style="{StaticResource Nav.Item}" Content="Play"
                                     GroupName="Nav" IsChecked="True" Tag="play" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavVersions" Style="{StaticResource Nav.Item}" Content="Versions"
                                     GroupName="Nav" Margin="0,2,0,0" Tag="versions" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource Nav.Item}" Content="Settings"
                                     GroupName="Nav" Margin="0,2,0,0" Tag="settings" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavLog" Style="{StaticResource Nav.Item}" Content="Logs"
                                     GroupName="Nav" Margin="0,2,0,0" Tag="log" Checked="Nav_Checked"/>
                    </StackPanel>

                    <!-- account -->
                    <Border Grid.Row="2" Background="{StaticResource Brush.Surface}" CornerRadius="10"
                            BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" Padding="12">
                        <StackPanel>
                            <TextBlock Text="ACCOUNT" Style="{StaticResource Text.Label}"/>
                            <TextBlock x:Name="AccountText" Text="Not signed in" Margin="0,7,0,0"
                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DeviceCodeText" Margin="0,6,0,0" TextWrapping="Wrap"
                                       FontSize="12" Foreground="{StaticResource Brush.Accent}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                <Button x:Name="SignInButton" Style="{StaticResource Button.Primary}" Content="Sign in"
                                        Padding="14,7" FontSize="12" Click="SignInButton_Click"/>
                                <Button x:Name="SignOutButton" Style="{StaticResource Button.Ghost}" Content="Sign out"
                                        Padding="12,7" FontSize="12" Margin="8,0,0,0" IsEnabled="False"
                                        Click="SignOutButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- pages -->
            <Grid Grid.Column="1" x:Name="PageHost">

                <!-- play page -->
                <Grid x:Name="PlayPage" Margin="34,30,34,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Image Grid.Row="0" Grid.RowSpan="6" Source="{StaticResource BrandMark}" Width="300" Height="300"
                           Opacity="0.035" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,10,0" IsHitTestVisible="False"/>

                    <TextBlock Grid.Row="0" Text="READY TO PLAY" Style="{StaticResource Text.Label}"/>
                    <TextBlock Grid.Row="1" x:Name="VersionHero" Text="—" FontSize="32" FontWeight="SemiBold"
                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="2" x:Name="VersionMeta" Text="No version selected"
                               Style="{StaticResource Text.Body}" Margin="0,3,0,0"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,24,0,0">
                        <Button x:Name="LaunchButton" Style="{StaticResource Button.Primary}"
                                Content="Launch Minecraft" Click="LaunchButton_Click"/>
                        <Button x:Name="CancelButton" Style="{StaticResource Button.Ghost}" Content="Cancel"
                                Margin="10,0,0,0" IsEnabled="False" Click="CancelButton_Click"/>
                        <Button x:Name="FolderButton" Style="{StaticResource Button.Ghost}" Content="Open folder"
                                Margin="10,0,0,0" Click="FolderButton_Click"/>
                    </StackPanel>

                    <Border Grid.Row="4" Background="{StaticResource Brush.Surface}" CornerRadius="10"
                            BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" Padding="14,12"
                            Margin="0,22,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="OfflineCheck" Style="{StaticResource Toggle}" Content="Offline mode"
                                      VerticalAlignment="Center" Checked="OfflineCheck_Changed"
                                      Unchecked="OfflineCheck_Changed"/>
                            <TextBox x:Name="OfflineNameBox" Style="{StaticResource Input}" Width="130" Height="30"
                                     Margin="16,0,0,0" IsEnabled="False" TextChanged="OfflineNameBox_TextChanged"
                                     ToolTip="Player name for offline play: 3-16 letters, digits or _"/>
                            <TextBlock x:Name="OfflineHint" Text="Single player and LAN only — online servers need a sign-in."
                                       Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Warn}"
                                       MaxWidth="300" Margin="16,0,0,0" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- versions page -->
                <Grid x:Name="VersionsPage" Margin="34,30,34,22" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="VERSIONS" Style="{StaticResource Text.Label}"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,14">
                        <Button x:Name="RefreshVersionsButton" Style="{StaticResource Button.Ghost}"
                                Content="Refresh list" Click="RefreshVersionsButton_Click"/>
                        <CheckBox x:Name="SnapshotsCheck" Style="{StaticResource Toggle}" Content="Show snapshots"
                                  Margin="18,0,0,0" VerticalAlignment="Center"
                                  Checked="SnapshotsCheck_Changed" Unchecked="SnapshotsCheck_Changed"/>
                    </StackPanel>

                    <Border Grid.Row="2" Background="{StaticResource Brush.Surface}" CornerRadius="10"
                            BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" Padding="6">
                        <ListBox x:Name="VersionList" Style="{StaticResource List.Version}"
                                 SelectionChanged="VersionList_SelectionChanged"/>
                    </Border>
                </Grid>

                <!-- settings page -->
                <Grid x:Name="SettingsPage" Margin="34,30,34,22" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="SETTINGS" Style="{StaticResource Text.Label}"/>

                    <Border Grid.Row="1" Background="{StaticResource Brush.Surface}" CornerRadius="10"
                            BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" Padding="18,16"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Memory" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextDim}"/>
                            <Slider x:Name="MemorySlider" Grid.Row="0" Grid.Column="1" Style="{StaticResource Slider.Slim}"
                                    Minimum="1024" Maximum="32768" TickFrequency="512" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" Margin="0,0,14,0"
                                    ValueChanged="MemorySlider_ValueChanged"/>
                            <TextBlock x:Name="MemoryText" Grid.Row="0" Grid.Column="2" Text="4096 MB"
                                       MinWidth="64" TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Java path" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextDim}" Margin="0,14,0,0"/>
                            <TextBox x:Name="JavaPathBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Input}"
                                     Height="30" Margin="0,14,14,0" TextChanged="JavaPathBox_TextChanged"/>
                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Button.Ghost}"
                                    Content="Browse…" Padding="12,6" Margin="0,14,0,0"
                                    Click="BrowseJavaButton_Click"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Extra JVM args" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextDim}" Margin="0,14,0,0"/>
                            <TextBox x:Name="ExtraJvmBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                     Style="{StaticResource Input}" Height="30" Margin="0,14,0,0"
                                     TextChanged="ExtraJvmBox_TextChanged"
                                     ToolTip="For example: -XX:+UseZGC -Dfile.encoding=UTF-8"/>

                            <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,18,0,0">
                                <CheckBox x:Name="DownloadJavaCheck" Style="{StaticResource Toggle}"
                                          Content="Download Java from Mojang when missing" Margin="0,0,22,0"
                                          Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                                <CheckBox x:Name="TurboCheck" Style="{StaticResource Toggle}"
                                          Content="Turbo JVM flags (Java 17+)" Margin="0,0,22,0"
                                          Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                                <CheckBox x:Name="KeepOpenCheck" Style="{StaticResource Toggle}"
                                          Content="Keep launcher open while playing"
                                          Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                            </WrapPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                                        Margin="0,14,0,0">
                                <CheckBox x:Name="CheckUpdatesCheck" Style="{StaticResource Toggle}"
                                          Content="Check for updates on startup" VerticalAlignment="Center"
                                          Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                                <Button x:Name="CheckUpdatesButton" Style="{StaticResource Button.Ghost}"
                                        Content="Check now" Padding="12,6" Margin="22,0,0,0"
                                        Click="CheckUpdatesButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- log page -->
                <Grid x:Name="LogPage" Margin="34,30,34,22" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="LOG" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
                        <TextBlock Text="everything FastCraft and Minecraft wrote" Style="{StaticResource Text.Body}"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource Brush.Surface}" CornerRadius="10"
                            BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" Padding="12,10"
                            Margin="0,12,0,0">
                        <TextBox x:Name="LogBox" Background="Transparent" Foreground="{StaticResource Brush.TextDim}"
                                 BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                 IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 SelectionBrush="{StaticResource Brush.Accent}"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- =========================== status strip ========================== -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Line}"
                BorderThickness="0,1,0,0" Padding="18,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Idle" Foreground="{StaticResource Brush.TextDim}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="Progress" Grid.Column="1" Style="{StaticResource Progress.Slim}"
                             Width="220" Height="4" Minimum="0" Maximum="1" Value="0"
                             VerticalAlignment="Center" Margin="18,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
