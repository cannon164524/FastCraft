<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FastCraft</AssemblyName>
    <RootNamespace>FastCraft</RootNamespace>
    <StartupObject>FastCraft.Program</StartupObject>
    <!-- WPF needs its native DLLs (PresentationNative, D3DCompiler, …). Bundle them into
         the exe, otherwise the published "single file" is only one of many files and the
         app exits silently when started on its own. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <Version>1.0.0</Version>
    <!-- The exe icon is drawn by tools/make-icon.ps1, which the CI workflow and
         build-exe.bat run before publishing. Without the file the build still works,
         just with the default Windows icon. -->
    <ApplicationIcon Condition="Exists('Assets\FastCraft.ico')">Assets\FastCraft.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only third-party dependency: Windows DPAPI, used to encrypt the stored Microsoft session. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
